'PM2_IMM.onset', 'PM2_IMM.offset', 'PM2_IMM.object_code', 'PM2_IMM.first_action', 'PM2_IMM.second_action', 'PM2_IMM.temporal_order',
'PM2_DEL.onset', 'PM2_DEL.offset', 'PM2_DEL.object_code', 'PM2_DEL.first_action', 'PM2_DEL.second_action', 'PM2_DEL.temporal_order')]
data_subset_NA <- na.omit(data_subset)
# Convert to long format
DI_long_data <- data_subset_NA %>%
pivot_longer(
cols = matches("^(AM|PM)\\d?_"),  # Match both AM1_ and PM_
names_to = c("session_info", ".value"),
names_sep = "\\."
) %>%
separate(session_info, into = c("session", "recall"), sep = "_", remove = FALSE)
# Extract ID and Wave from the filename
DI_long_data <- DI_long_data %>%
mutate(
ID = str_extract(filename, "^[^_]+_\\d+"),  # Extracts "TNS_102"
Wave = str_extract(filename, "W\\d+"),
item_group = substr(object_code, 1, 1) )
#read each sheet of the counterbalancing file in
file_path <- "C:/Users/mhorg/OneDrive - University of Massachusetts/InfantR01/COUNTERBALANCING.xlsx"
W1 <- read_excel(file_path, sheet = "Wave 1 (9 mos)")
file_path <- "C:/Users/mhorg/OneDrive - University of Massachusetts/InfantR01/COUNTERBALANCING.xlsx"
W1 <- read_excel(file_path, sheet = "Wave 1 (9 mos)")
W1 <- read_excel(file_path, sheet = "Wave 1 (9 mos)")
W2 <- read_excel(file_path, sheet = "Wave 2 (12 mos)")
W3 <- read_excel(file_path, sheet = "Wave 3 (15 mos)")
W1 <- read_excel(file_path, sheet = "Wave 1 (9 mos)")
W2 <- read_excel(file_path, sheet = "Wave 2 (12 mos)")
W3 <- read_excel(file_path, sheet = "Wave 3 (15 mos)")
W1$Wave <- rep("W1", nrow(W1))
W1 <- W1  %>%
relocate(Wave, .before = 26)  # Moves it to column 26
W1 <- W1  %>%
relocate(Wave, .before = 26)  # Moves it to column 26
W2$Wave <- rep("W2", nrow(W2))
W2 <- W2  %>%
relocate(Wave, .before = 26)  # Moves it to column 26
W3$Wave <- rep("W3", nrow(W3))
W3$Wave <- rep("W3", nrow(W3))
W3 <- W3  %>%
relocate(Wave, .before = 26)  # Moves it to column 26
W1 <- W1[ , 1:26]
W1 <- W1[ , 1:26]
W2 <- W2[ , 1:26]
W3 <- W3[ , 1:26]
W3 <- W3[ , 1:26]
all_counterbalance <- rbind(W1, W2, W3)
all_counterbalance <- all_counterbalance %>%
select(, -c(Child))
# Convert to long format
long_data_counterbalance <- all_counterbalance %>%
pivot_longer(
cols = starts_with("AM") | starts_with("PM"),  # Select AM and PM columns
names_to = "Condition",
values_to = "item_group"
) %>%
mutate(
Type = case_when(
grepl("Imitation", Condition) ~ "Imitation",
grepl("Control", Condition) ~ "Control",
TRUE ~ NA_character_
),
Time = case_when(
grepl("AM", Condition) ~ "AM",
grepl("PM", Condition) ~ "PM",
TRUE ~ NA_character_
),
session = paste0(Time, str_extract(Condition, "\\d+"))  # Extract number and combine with AM/PM
)
# Merge datasets based on common identifiers (adjust join keys as needed)
DI_labelled <- DI_long_data %>%
left_join(long_data_counterbalance, by = c("ID" = "PID", "Wave" = "Wave", "item_group" = "item_group"))  # Adjust if needed
# Add a variable to designate if it was a Wake Day or a Sleep Day
DI_labelled <- DI_labelled %>%
group_by(ID, Wave) %>%
mutate(Visit = case_when(
grepl("1$", session.x) ~ V1_Condition,  # Assign V1_Condition when session.x ends in 1
grepl("2$", session.x) ~ V2_Condition   # Assign V2_Condition when session.x ends in 2
)) %>%
ungroup()
DI_labelled$first_action <- as.numeric(DI_labelled$first_action)
DI_labelled$second_action <- as.numeric(DI_labelled$second_action)
DI_labelled$temporal_order <- as.numeric(DI_labelled$temporal_order)
DI_labelled <- DI_labelled %>%
mutate(DI_sum = rowSums(across(c(first_action, second_action, temporal_order)), na.rm = TRUE),
DI_prop = DI_sum/3)
imitation_only <- DI_labelled %>%
filter(Type == "Imitation")
imitation_only_sums_byPID <- imitation_only %>%
group_by(ID, Wave, Type, recall, Time, Visit) %>%
summarise(DI_total_sum = sum(first_action, second_action, temporal_order),
DI_total_prop = DI_total_sum/12)
#select only the babies in AM skip condition
PIDs <- c("ITNS_12", "ITNS_15", "ITNS_16", "ITNS_17",
"ITNS_18", "ITNS_19", "ITNS_20", "ITNS_27",
"ITNS_33", "ITNS_34", "ITNS_35", "ITNS_39",
"ITNS_102", "ITNS_103", "ITNS_105", "ITNS_106",
"ITNS_107", "ITNS_108", "ITNS_109", "ITNS_112",
"ITNS_110", "ITNS_112", "ITNS_113", "ITNS_115",
"ITNS_116", "ITNS_119", "ITNS_120", "ITNS_122",
"ITNS_123", "ITNS_124")
imitation_only_sums_byPID <- imitation_only_sums_byPID %>%
filter( ID %in% PIDs)
imitation_only_sums_byPID <- imitation_only_sums_byPID %>%
mutate(Session_VisitType_Recall = paste(Time, Visit, recall, sep = "_"))
imitation_only_sums_byPID %>%
ungroup() %>%
dplyr::summarise(n = dplyr::n(), .by = c(ID, Wave, Session_VisitType_Recall)) %>%
dplyr::filter(n > 1)
DI_wide <- imitation_only_sums_byPID %>%
ungroup() %>%
select(ID, Wave, Session_VisitType_Recall, DI_total_prop) %>%
pivot_wider(names_from = Session_VisitType_Recall, values_from = c(DI_total_prop))
write.csv(DI_wide, "C:/Users/mhorg/OneDrive - University of Massachusetts/InfantR01/Data/DI_wide.csv")
View(imitation_only_sums_byPID)
View(DI_labelled)
