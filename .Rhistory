file_list <- list.files(path = data_dir, pattern = "\\.csv$", full.names = TRUE)
# Function to read each CSV and ensure all columns are character type
read_and_label <- function(file) {
df <- read_csv(file, col_types = cols())  # Read the CSV
df <- mutate_all(df, as.character)  # Convert all columns to character
