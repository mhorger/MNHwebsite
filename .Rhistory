# Add a variable to designate if it was a Wake Day or a Sleep Day
DI_labelled <- DI_labelled %>%
group_by(ID, Wave) %>%
mutate(Visit = case_when(
grepl("1$", session.x) ~ V1_Condition,  # Assign V1_Condition when session.x ends in 1
grepl("2$", session.x) ~ V2_Condition   # Assign V2_Condition when session.x ends in 2
)) %>%
ungroup()
DI_labelled$first_action <- as.numeric(DI_labelled$first_action)
DI_labelled$second_action <- as.numeric(DI_labelled$second_action)
DI_labelled$temporal_order <- as.numeric(DI_labelled$temporal_order)
DI_labelled <- DI_labelled %>%
mutate(DI_sum = rowSums(across(c(first_action, second_action, temporal_order)), na.rm = TRUE),
DI_prop = DI_sum/3)
View(imitation_only)
imitation_only <- DI_labelled %>%
filter(Type == "Imitation")
imitation_only <- DI_labelled %>%
filter(Type == "Imitation")
imitation_only_sums_byPID <- imitation_only %>%
group_by(ID, Wave, Condition, Type, session_info, recall, Time, session.x, Visit) %>%
summarise(score_m = mean(DI_sum),
score_sd = sd(DI_sum),
prop_m = mean(DI_prop),
prop_sd = sd(DI_prop))
imitation_only_sums_byPID <- imitation_only %>%
group_by(ID, Wave, Type, recall, Time, Visit) %>%
summarise(DI_total_sum = sum(first_action, second_action, temporal_order),
DI_total_prop = DI_total_sum/12)
imitation_only_sums_byPID <- imitation_only_sums_byPID %>%
filter( ID %in% PIDs)
imitation_only_sums_byPID <- imitation_only_sums_byPID %>%
mutate(Session_VisitType_Recall = paste(Time, Visit, recall, sep = "_"))
imitation_only_sums_byPID %>%
ungroup() %>%
dplyr::summarise(n = dplyr::n(), .by = c(ID, Wave, Session_VisitType_Recall)) %>%
dplyr::filter(n > 1)
DI_wide <- imitation_only_sums_byPID %>%
ungroup() %>%
select(ID, Wave, Session_VisitType_Recall, DI_total_prop) %>%
pivot_wider(names_from = Session_VisitType_Recall, values_from = c(DI_total_prop))
write.csv(DI_wide, "C:/Users/mhorg/OneDrive - University of Massachusetts/InfantR01/Data/DI_wide.csv")
write.csv(imitation_only, "C:/Users/mhorg/OneDrive - University of Massachusetts/InfantR01/Data/imitation_only.csv")
